@model IEnumerable<Zoo.ViewModels.Zoo.ZooIndexViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Zoos</h1>


<p>
    <a asp-action="Create">Create New Zoo</a> |
    <a asp-controller="Animal"
       asp-action="Index">
        View Animals
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstablishedYear)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EstablishedYear)
                </td>
           
                <td>
                    <a asp-controller="Zoo" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="Zoo" asp-action="Detail" asp-route-id="@item.Id">Detail</a> |
                    <a asp-controller="Zoo" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
