@model Zoo.ViewModels.Caretaker.CaretakerDetailsViewModel

@{
    ViewData["Title"] = "Детайли за пазач";
}

<h1>Детайли за пазач</h1>

<div>
    <h4>Пазач</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Име</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Фамилия</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Имейл</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Телефонен номер</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>

        <dt class="col-sm-2">Животни</dt>
        <dd class="col-sm-10">@Model.AnimalName</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Редактирай</a> |
    <a asp-action="Index">Назад към списъка</a>
</div>
