@model IEnumerable<Zoo.ViewModels.Caretaker.CaretakerIndexViewModel>

@{
    ViewData["Title"] = "Пазачи";
}

<h1>Списък с пазачи</h1>

<p>
    <a asp-action="Create">Създай нов пазач</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Име</th>
            <th>Фамилия</th>
            <th>Имейл</th>
            <th>Телефонен номер</th>
            <th>Животни</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.AnimalName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>